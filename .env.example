# Spotify API credentials
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# Spotify playlist ID to add songs to
# Get this from the playlist URL: https://open.spotify.com/playlist/<PLAYLIST_ID>
SPOTIFY_PLAYLIST_ID=your_playlist_id

# Google Sheets
# The sheet ID is in the URL after /spreadsheets/d/
GOOGLE_SHEET_ID=12AdrjZ1eLsbFv_M_DUqrRMidvxvyKZbeEVNGzrpaE_M
GOOGLE_SHEET_GID=751801221

# Path to your Google service account JSON key file
# Download from: https://console.cloud.google.com/ (Service Accounts -> Keys)
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
